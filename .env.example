# LearnFlow Environment Variables

# Application
APP_NAME=LearnFlow
VERSION=1.0.0
ENV=production
DEBUG=false

# Database
DATABASE_URL=postgresql://learnflow:learnflow123@postgres.learnflow.svc:5432/learnflow

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Security
JWT_SECRET=your-secret-key-minimum-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kafka
KAFKA_BROKERS=kafka.learnflow.svc:9092

# Dapr
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# Code Sandbox
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT_MB=50

# MCP Server
MCP_SERVER_PORT=8765
MCP_SERVER_ENABLED=true

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
